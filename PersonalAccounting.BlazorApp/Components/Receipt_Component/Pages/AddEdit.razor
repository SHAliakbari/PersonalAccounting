@page "/Receipts/Add/{id?}"
@rendermode InteractiveServer
@attribute [Authorize]

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.StaticFiles
@using Microsoft.EntityFrameworkCore
@using PersonalAccounting.BlazorApp.Components.Account
@using System.Globalization
@using PersonalAccounting.BlazorApp.Components.Receipt_Component.Services
@using PersonalAccounting.Domain.Data
@using System.Security.Claims
@using PersonalAccounting.Domain.Services
@using PersonalAccounting.Domain.Services.OCR
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.PixelFormats
@using SixLabors.ImageSharp.Processing
@using System.Text.Json
@using System.Text

<PageTitle>@(isNew ? "New" : "Edit") Receipt</PageTitle>

<script type="text/javascript">
    async function viewFileFromStream(fileName, contentStreamReference, mimeType) {
        window.URL = window.URL || window.webkitURL;

        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer], { type: mimeType });
        const url = window.URL.createObjectURL(blob);

        const anchorElement = document.createElement('a');
        document.body.appendChild(anchorElement);

        anchorElement.setAttribute("type", "hidden");
        anchorElement.href = url;
        anchorElement.target = "_blank";
        anchorElement.click();

        anchorElement.remove();
        window.URL.revokeObjectURL(url);
    };

    async function viewFileFromUrl(url) {
        window.URL = window.URL || window.webkitURL;

        const anchorElement = document.createElement('a');
        anchorElement.setAttribute("type", "hidden");
        anchorElement.href = url;
        anchorElement.target = "_blank";

        document.body.appendChild(anchorElement);
        anchorElement.click();
        anchorElement.remove();
    };
</script>
<style>
    .details .detail {
        border: 1px solid gray;
    }

    .grid {
        margin-top: 5px;
    }

        .grid .details {
            width: 100%;
        }

            .grid .details td, .grid .details th {
                border: 1px solid gray;
            }

            /* Stripe effect */
            .grid .details tbody tr {
                background-color: rgba(0,0,0,0.04);
            }

                .grid .details tbody tr:nth-child(even) {
                    background: rgba(255,255,255,0.4);
                }

                .grid .details tbody tr.selectedRow {
                    /* background-color: forestgreen; */
                }

    .detailSection {
        border: 1px solid gray;
        margin: 10px;
    }

</style>
@if (isNew)
{
    <h1>Add Receipt</h1>
}
else
{
    <h1>Edit/View Receipt</h1>
}

<div>
    <EditForm Model="master" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <ReceiptForm Master="master" IsAdmin="isAdmin" Users="users" SelectedDetail="selectedDetail"
                     OpenShareModalForAll="OpenShareModalForAll" 
                     ShareModalForAllSave="ShareModalForAllSave" 
                     FillPayedByUserInformation="(e) => FillPayedByUserInformation(e)" />

        <ValidationSummary />
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <ReceiptImageUpload Master="master" IsAdmin="isAdmin" UploadStatus="uploadStatus" 
                            IsReceiptImageUploaded="isReceiptImageUploaded" IsProcessing="isProcessing" 
                            LoadFiles="(e) => LoadFiles(e)" OpenFile="(r) => OpenFile(r)" 
                            ShowConfirmationClearFormReprocess="ShowConfirmationClearFormReprocess" />

        <hr />

        <ReceiptDetails Master="master" IsAdmin="isAdmin" Users="users" OnDetailSaved="OnDetailSaved" />
        <div class="text-end">
            @if (isAdmin)
            {
                <button type="submit" disabled="@isSaving" class="btn btn-primary btn-lg">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        @("Saving...")
                    }
                    else
                    {
                        <text>Save Receipt</text>
                    }
                </button>
            }
        </div>

    </EditForm>

    <ConfirmModal Show="showConfirmationClearFormReprocess" Message="Are you sure you want to perform this action? Will erase the form content!" OnConfirm="ConfirmActionClearFormReprocess" OnCancel="CancelConfirmationClearFormReprocess" />
</div>